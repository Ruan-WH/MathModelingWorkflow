      <mxCell id="input" value="输入问题一遮蔽评价器与&lt;br&gt;&lt;span style=&quot;font-family:'Times New Roman';&quot;&gt;FY1、M1&lt;/span&gt; 运动参数" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#111111;strokeWidth=2.5;fontSize=18;fontFamily=SimSun;" vertex="1" parent="1"><mxGeometry x="214" y="96" width="400" height="66" as="geometry"/></mxCell>
